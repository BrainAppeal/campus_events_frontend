<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<T3DataStructure>
    <meta type="array">
        <langDisable>1</langDisable>
        <langDatabaseOverlay>1</langDatabaseOverlay>
    </meta>
    <ROOT type="array">
        <sheetTitle>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_tab.settings</sheetTitle>
        <type>array</type>
        <el>
            <settings.externalListUrl>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.externalListUrl</label>
                <config>
                    <type>input</type>
                    <size>40</size>
                    <eval>required</eval>
                    <default>https://demo.campus-events.com/</default>
                </config>
            </settings.externalListUrl>

            <settings.startingpoint>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.storageEvent</label>
                <config>
                    <type>group</type>
                    <internal_type>db</internal_type>
                    <allowed>pages</allowed>
                    <size>3</size>
                    <maxitems>50</maxitems>
                    <minitems>1</minitems>
                </config>
            </settings.startingpoint>

            <!-- Limit Start -->
            <settings.limit>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.limit</label>
                <config>
                    <type>input</type>
                    <size>5</size>
                    <eval>num</eval>
                </config>
            </settings.limit>

            <settings.viewLists>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.viewLists</label>
                <config>
                    <type>select</type>
                    <renderType>selectMultipleSideBySide</renderType>
                    <autoSizeMax>50</autoSizeMax>
                    <foreign_table>tx_campuseventsconnector_domain_model_viewlist</foreign_table>
                    <foreign_table_where>AND (tx_campuseventsconnector_domain_model_viewlist.sys_language_uid = 0 OR tx_campuseventsconnector_domain_model_viewlist.l10n_parent = 0) AND LENGTH(tx_campuseventsconnector_domain_model_viewlist.name) > 0 ORDER BY tx_campuseventsconnector_domain_model_viewlist.name</foreign_table_where>
                    <maxitems>99</maxitems>
                    <size>5</size>
                </config>
            </settings.viewLists>

            <settings.filterCategoryMode>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.filterCategoryMode</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <items type="array">
                        <numIndex index="0" type="array">
                            <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.filterCategoryMode.exclude</label>
                            <value/>
                        </numIndex>
                        <numIndex index="1" type="array">
                            <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.filterCategoryMode.include</label>
                            <value>include</value>
                        </numIndex>
                    </items>
                    <default/>
                </config>
            </settings.filterCategoryMode>

            <settings.filterCategoryMode>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.filterCategoryMode</label>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <items type="array">
                        <numIndex index="0" type="array">
                            <numIndex index="0">LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.filterCategoryMode.exclude</numIndex>
                            <numIndex index="1"></numIndex>
                        </numIndex>
                        <numIndex index="1" type="array">
                            <numIndex index="0">LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.filterCategoryMode.include</numIndex>
                            <numIndex index="1">include</numIndex>
                        </numIndex>
                    </items>
                    <default></default>
                </config>
            </settings.filterCategoryMode>

            <settings.excludeFilterCategories>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.excludeFilterCategories</label>
                <config>
                    <type>select</type>
                    <renderType>selectMultipleSideBySide</renderType>
                    <autoSizeMax>50</autoSizeMax>
                    <foreign_table>tx_campuseventsconnector_domain_model_filtercategory</foreign_table>
                    <foreign_table_where>AND (tx_campuseventsconnector_domain_model_filtercategory.sys_language_uid = 0 OR tx_campuseventsconnector_domain_model_filtercategory.l10n_parent = 0) AND LENGTH(tx_campuseventsconnector_domain_model_filtercategory.name) > 0 ORDER BY tx_campuseventsconnector_domain_model_filtercategory.name</foreign_table_where>
                    <maxitems>99</maxitems>
                    <size>5</size>
                </config>
            </settings.excludeFilterCategories>

            <!-- Timespan Layout -->
            <settings.timespan>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.timespan</label>
                <onChange>reload</onChange>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <items type="array">
                        <numIndex index="0" type="array">
                            <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.timespan.future</label>
                            <value>future</value>
                        </numIndex>
                        <numIndex index="1" type="array">
                            <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.timespan.all</label>
                            <value>all</value>
                        </numIndex>
                        <numIndex index="2" type="array">
                            <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.timespan.past</label>
                            <value>past</value>
                        </numIndex>
                    </items>
                    <maxitems>1</maxitems>
                    <size>1</size>
                </config>
            </settings.timespan>
            <settings.timespanDateField>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.timespanDateField</label>
                <onChange>reload</onChange>
                <config>
                    <type>select</type>
                    <renderType>selectSingle</renderType>
                    <items type="array">
                        <numIndex index="0" type="array">
                            <label/>
                            <value/>
                        </numIndex>
                        <numIndex index="1" type="array">
                            <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.timespanDateField.start_tstamp</label>
                            <value>start_tstamp</value>
                        </numIndex>
                        <numIndex index="2" type="array">
                            <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.timespanDateField.end_tstamp</label>
                            <value>end_tstamp</value>
                        </numIndex>
                    </items>
                    <maxitems>1</maxitems>
                    <size>1</size>
                </config>
            </settings.timespanDateField>

            <!-- Template Layout -->
            <settings.templateLayout>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.templateLayout</label>
                <config>
                    <type>select</type>
                    <itemsProcFunc>BrainAppeal\CampusEventsFrontend\Hooks\ItemsProcFunc->user_templateLayout</itemsProcFunc>
                    <renderType>selectSingle</renderType>
                    <items>
                        <numIndex index="0" type="array">
                            <label/>
                            <value/>
                        </numIndex>
                    </items>
                </config>
            </settings.templateLayout>

            <settings.detailPid>
                <label>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.detailPid</label>
                <description>LLL:EXT:campus_events_frontend/Resources/Private/Language/locallang_be.xlf:flexforms_general.detailPid.description</description>
                <config>
                    <type>group</type>
                    <allowed>pages</allowed>
                    <size>1</size>
                    <maxitems>1</maxitems>
                    <minitems>0</minitems>
                    <suggestOptions>
                        <default>
                            <addWhere>AND pages.doktype NOT in (6,199,254)</addWhere>
                        </default>
                    </suggestOptions>
                </config>
            </settings.detailPid>
        </el>
    </ROOT>
</T3DataStructure>
